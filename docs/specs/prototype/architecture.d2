direction: down
browser: "Trusted local operator" {
 console: "[NEW] Two client lanes"
 previews: "[NEW] Scoped previews and downloads"
}
host: "Local Node application" {
 runs: "[NEW] Immutable engagement workers"
 broker: "[NEW] Scope and clearance broker"
 state: "[NEW] SQLite input and artifact state" {shape: cylinder}
 fixtures: "[NEW] Canonical client fixtures"
 compiler: "[NEW] Workflow compiler and tests"
 delivery: "[NEW] Client-matching delivery gate"
}
external: "Vendor services" {
 hydra: "[EXTERNAL] HydraDB separate collections"
 model: "[EXTERNAL] Model separate histories"
}
browser.console -> host.runs: "Spawn; reassignment creates fresh run"
host.runs -> host.broker: "Query; bound identity"
host.broker -> external.hydra: "Fixed client scope and ACL"
host.broker -> host.fixtures: "Ranked IDs to verified bodies"
host.broker -> host.state: "Admit matching client and clearance"
host.runs -> external.model: "Permitted context only"
host.runs -> host.compiler: "Bounded workflow JSON"
host.fixtures -> host.compiler: "Independent acceptance cases"
host.compiler -> host.state: "Client-owned tested app"
host.state -> host.delivery: "Identity, provenance, passed tests"
host.delivery -> browser.previews: "Matching client standalone app"
