      "html": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"referrer\" content=\"no-referrer\"><title>Operations improvement | Internal proposal pricing</title><style>\n*{box-sizing:border-box}body{margin:0;background:#f4f5f7;color:#1c2636;font:16px system-ui,sans-serif;padding:28px}main{max-width:1040px;margin:auto}.classification{border:1px solid #e2c18b;background:#fff5df;border-radius:10px;padding:12px 16px;font-size:13px;color:#704814}.eyebrow{font-size:12px;font-weight:750;letter-spacing:.13em;text-transform:uppercase;color:#244e9c;margin-top:30px}h1{font-size:38px;line-height:1.1;letter-spacing:-.045em;margin:10px 0}p{line-height:1.5;color:#627085}.layout{display:grid;grid-template-columns:minmax(250px,.9fr) minmax(330px,1.1fr);gap:22px;margin-top:24px}.panel{background:white;border:1px solid #dce2e9;border-radius:16px;padding:26px}h2{font-size:18px;margin:0 0 20px}label{display:block;font-size:13px;font-weight:650;margin:16px 0 7px}input{width:100%;border:1px solid #c5cfdd;border-radius:8px;padding:12px;font:inherit;font-size:21px}button{width:100%;background:#244e9c;border:0;color:white;border-radius:8px;padding:14px;margin-top:22px;font:inherit;font-weight:650;cursor:pointer}input:focus-visible,button:focus-visible{outline:3px solid #e5b543;outline-offset:3px}.metric{display:flex;justify-content:space-between;gap:20px;padding:15px 0;border-bottom:1px solid #e7ecf1}.metric span{font-size:14px;color:#627085}.metric strong{font-size:21px}.total strong{font-size:30px;color:#244e9c}#status{padding:16px;margin-top:22px;border-radius:10px;font-weight:700}#status.ok{background:#e9f5ed;color:#23623d}#status.review{background:#fff0e0;color:#8b4b0b}#reasons{font-size:14px;line-height:1.7;color:#754719}.policy{font-size:12px;border-top:1px solid #dce2e9;padding-top:16px;margin-top:24px;color:#647185}#error{color:#a3232d;min-height:22px;font-size:13px;margin-top:10px}footer{font-size:12px;color:#778296;margin-top:20px}@media(max-width:700px){body{padding:16px}.layout{grid-template-columns:1fr}h1{font-size:30px}}\n</style></head><body><main><div class=\"classification\"><strong>Internal partner-only tool</strong> \u00b7 Restricted commercial policy is included. Do not publish or share with clients.</div><div class=\"eyebrow\">crest engagement \u00b7 proposal planning</div><h1>Proposal summary</h1><p>Clean navy and teal proposal summary with readable headings. All examples are synthetic.</p><div class=\"layout\"><section class=\"panel\"><h2>Operations improvement</h2><form id=\"quote-form\"><label for=\"consultantDays\">Consultant days</label><input id=\"consultantDays\" type=\"number\" min=\"0\" max=\"3650\" step=\"1\" value=\"10\" required><label for=\"architectDays\">Architect days</label><input id=\"architectDays\" type=\"number\" min=\"0\" max=\"3650\" step=\"1\" value=\"5\" required><label for=\"discount\">Proposed discount (%)</label><input id=\"discount\" type=\"text\" inputmode=\"decimal\" value=\"0\" required aria-describedby=\"error\"><button type=\"submit\">Recalculate proposal</button><div id=\"error\" role=\"alert\"></div></form></section><section class=\"panel\" aria-live=\"polite\"><h2>Commercial review</h2><div class=\"metric\"><span>Undiscounted fees</span><strong id=\"gross\"></strong></div><div class=\"metric\"><span>Delivery cost</span><strong id=\"cost\"></strong></div><div class=\"metric total\"><span>Proposed fees</span><strong id=\"total\"></strong></div><div class=\"metric\"><span>Margin</span><strong id=\"margin\"></strong></div><div id=\"status\"></div><ul id=\"reasons\"></ul><p class=\"policy\">Discount ceiling: 20.00%. Margin floor: 35.00%. An in-policy result is not an authorization to send a proposal.</p></section></div><footer>Invented engagement and commercial figures. Standalone calculator with no network requests. Human partner approval remains required.</footer></main><script id=\"proposal-data\" type=\"application/json\">{\"client\":\"crest\",\"heading\":\"Proposal summary\",\"description\":\"Clean navy and teal proposal summary with readable headings. All examples are synthetic.\",\"accent\":\"blue\",\"projectName\":\"Operations improvement\",\"consultantDays\":10,\"architectDays\":5,\"consultantRateCents\":200000,\"architectRateCents\":300000,\"consultantCostCents\":120000,\"architectCostCents\":180000,\"maxDiscountBps\":2000,\"minMarginBps\":3500,\"reviewedPolicy\":{\"maxDiscountBps\":2000,\"minMarginBps\":3500}}</script><script>\n(function(){'use strict';\nconst config=JSON.parse(document.getElementById('proposal-data').textContent);\nconst calculateQuote=function calculateQuote(config,input){for(const[name,value,max]of[[\"consultantDays\",input.consultantDays,3650],[\"architectDays\",input.architectDays,3650],[\"discountBps\",input.discountBps,1e4],[\"consultantRateCents\",config.consultantRateCents,1e7],[\"architectRateCents\",config.architectRateCents,1e7],[\"consultantCostCents\",config.consultantCostCents,1e7],[\"architectCostCents\",config.architectCostCents,1e7],[\"maxDiscountBps\",config.maxDiscountBps,1e4],[\"minMarginBps\",config.minMarginBps,1e4]]){if(!Number.isSafeInteger(value)||value<0||value>max)throw new Error(`${name} must be a bounded nonnegative integer`)}if(input.consultantDays+input.architectDays===0)throw new Error(\"Enter at least one billable day\");const grossCents=input.consultantDays*config.consultantRateCents+input.architectDays*config.architectRateCents;if(grossCents===0)throw new Error(\"Gross fees must be positive\");const costCents=input.consultantDays*config.consultantCostCents+input.architectDays*config.architectCostCents;const discountedTotalCents=Math.round(grossCents*(1e4-input.discountBps)/1e4);const profitCents=discountedTotalCents-costCents;const belowMargin=discountedTotalCents===0||profitCents*1e4<discountedTotalCents*config.minMarginBps;const aboveDiscount=input.discountBps>config.maxDiscountBps;const reasons=[];if(aboveDiscount)reasons.push(\"Discount exceeds the approved ceiling\");if(belowMargin)reasons.push(discountedTotalCents===0?\"No net fees remain\":\"Margin is below the approved floor\");return{grossCents,costCents,discountedTotalCents,marginPercent:discountedTotalCents===0?null:profitCents/discountedTotalCents*100,reviewRequired:aboveDiscount||belowMargin,reasons}};\nconst form=document.getElementById('quote-form');\nconst money=new Intl.NumberFormat('en-US',{style:'currency',currency:'USD'});\nfunction update(event){if(event)event.preventDefault();try{\nconst raw=document.getElementById('discount').value.trim();if(!/^\\d{1,3}(?:\\.\\d{1,2})?$/.test(raw))throw new Error('Enter a discount from 0 to 100, with at most two decimal places.');\nconst parts=raw.split('.');const discountBps=Number(parts[0])*100+Number((parts[1]||'').padEnd(2,'0'));\nconst result=calculateQuote(config,{consultantDays:Number(document.getElementById('consultantDays').value),architectDays:Number(document.getElementById('architectDays').value),discountBps});\ndocument.getElementById('gross').textContent=money.format(result.grossCents/100);document.getElementById('cost').textContent=money.format(result.costCents/100);document.getElementById('total').textContent=money.format(result.discountedTotalCents/100);document.getElementById('margin').textContent=result.marginPercent===null?'Not defined':result.marginPercent.toFixed(3)+'%';\nconst status=document.getElementById('status');status.textContent=result.reviewRequired?'Commercial review required':'Within commercial policy';status.className=result.reviewRequired?'review':'ok';\ndocument.getElementById('reasons').replaceChildren(...result.reasons.map(function(reason){const li=document.createElement('li');li.textContent=reason;return li;}));document.getElementById('error').textContent='';\n}catch(error){document.getElementById('error').textContent=error.message;for(const id of ['gross','cost','total','margin','status'])document.getElementById(id).textContent='';document.getElementById('reasons').replaceChildren();}}\nform.addEventListener('submit',update);update();})();\n</script></body></html>",
